####################################################################
# config.be300 — Microwindows / Nano-X for the Casio BE-300
#
# Cross-built with mipsel-linux-gnu-g{cc,++} -march=mips2 + musl
# (matching the BusyBox build path in build_be300_kernel.sh).
#
# Single-binary mode (LINK_APP_INTO_SERVER=Y) to avoid Nano-X's UNIX
# socket server/client model on a 12 MB-RAM device. Each demo statically
# embeds the server.
#
# No libpng/libjpeg/libfreetype dependencies (we have not cross-built
# them yet) — only built-in BMP/GIF/PCF/FNT support.
####################################################################
ARCH                     = LINUX-MIPS
SHAREDLIBS               = N
SHAREDLINK               = N
DEBUG                    = N
OPTIMIZE                 = Y
VERBOSE                  = N
THREADSAFE               = N
PARALLEL                 = N

####################################################################
# Screen / input drivers
####################################################################
SCREEN                   = FB
MOUSE                    = EVDEVMOUSE
KEYBOARD                 = EVDEVKBD
SCREEN_WIDTH             = 240
SCREEN_HEIGHT            = 320
SCREEN_DEPTH             = 16
SCREEN_PIXTYPE           = MWPF_TRUECOLOR565

####################################################################
# Libraries to build
####################################################################
MICROWIN                 = N
NANOX                    = Y
NUKLEARUI                = N
NX11                     = N
ENGINE                   = N
TINYWIDGETS              = N

####################################################################
# Demos
####################################################################
FBEMULATOR               = N
MICROWINDEMO             = N
MICROWINMULTIAPP         = N
NANOXDEMO                = Y
HAVE_VNCSERVER_SUPPORT   = N

####################################################################
# Single-binary: server linked into each app
####################################################################
LINK_APP_INTO_SERVER     = Y
NANOWM                   = Y
HAVE_SHAREDMEM_SUPPORT   = N
HAVE_FILEIO              = Y

####################################################################
# Image format support — built-in only
####################################################################
HAVE_BMP_SUPPORT         = Y
HAVE_GIF_SUPPORT         = Y
HAVE_PNM_SUPPORT         = Y
HAVE_XPM_SUPPORT         = Y
HAVE_JPEG_SUPPORT        = N
HAVE_PNG_SUPPORT         = N
HAVE_TIFF_SUPPORT        = N

####################################################################
# Font support — PCF and built-in FNT only
####################################################################
HAVE_PCF_SUPPORT         = Y
HAVE_PCFGZ_SUPPORT       = N
PCF_FONT_DIR             = "fonts/pcf"
HAVE_FREETYPE_2_SUPPORT  = N
HAVE_HARFBUZZ_SUPPORT    = N
HAVE_T1LIB_SUPPORT       = N
HAVE_FNT_SUPPORT         = Y
HAVE_FNTGZ_SUPPORT       = N
HAVE_BIG5_SUPPORT        = N
HAVE_GB2312_SUPPORT      = N
HAVE_JISX0213_SUPPORT    = N
HAVE_KSC5601_SUPPORT     = N
HAVE_HZK_SUPPORT         = N
HAVE_HBF_SUPPORT         = N
HAVE_EUCJP_SUPPORT       = N

####################################################################
# Cross-toolchain prefix consumed by Arch.rules ($MIPSTOOLSPREFIX)
####################################################################
MIPSTOOLSPREFIX          = mipsel-linux-gnu-
HOSTCC                   = gcc

####################################################################
# Pass our musl/mips2 flags via EXTRAFLAGS. -mfpxx overrides Arch.rules's
# default `-msoft-float` for LINUX-MIPS so we match musl's hard-float ABI
# (no actual FPU instructions used; mfpxx is float-ABI-flexible).
####################################################################
EXTRAFLAGS               = -march=mips2 -mfpxx -isystem /work/musl-khdrs/include
