# BE-300 2.4.18 CF/IDE overlay — merge over config_be300 to re-enable
# the CompactFlash recovery root option.
#
# Patch 0003-be300-disable-cf-ide-default.patch turned off
# CASIO_BE300_CF + CONFIG_IDE in config_be300 because, without --cf
# attached to the emulator, the 2.4 IDE driver loops on
# `hda: lost interrupt` and blocks the NAND/touch/Stowaway init. This
# overlay flips them back on for `--restore --cf <image>` builds.
#
# Caveat: as of May 14, 2026, the modern emulator's CF model
# implements only IDENTIFY + READ_SECTORS. The 2.4 IDE driver issues
# SET_GEOMETRY / INITIALIZE_DEVICE_PARAMETERS during probe, which the
# emulator does not handle, so `hda` enumerates correctly but reads
# return DriveStatusError. This profile builds the kernel; boot
# validation with a real CF rootfs is pending an emulator update.
CONFIG_CASIO_BE300_CF=y
CONFIG_IDE=y
CONFIG_BLK_DEV_IDE=y
CONFIG_BLK_DEV_IDEDISK=y
CONFIG_IDEDISK_MULTI_MODE=y
# ext2 root from /dev/hda1 instead of /dev/ram or /dev/mtdblock3.
CONFIG_EXT2_FS=y
