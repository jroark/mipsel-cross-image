# TinyX maps /dev/fb0 directly from userspace. Enable /dev/mem only for this
# profile so /bin/be300-fbrefresh can poke the VRC4173 display engine and make
# emulator framebuffer mmap writes visible.
CONFIG_DEVMEM=y

# 16 MiB SDRAM profile matches the stock BE-300 hardware.  Earlier
# Xfbdev + libX11 + matchbox + xterm + Dillo profiles OOM-killed Xfbdev
# at ~13 MiB usable, but the trimmed dock+OSK session (no Dillo, no
# xterm, rxvt only, minimal font set) should fit.  If the OOM-killer
# fires again here, drop /bin/be300-xstatus from the steady state and/or
# tighten BusyBox applets in build_be300_kernel.sh Phase 1 before
# raising this back to 64.
CONFIG_CASIO_BE300_SDRAM_MB=16

# Kernel trim for the 16 MiB profile.  CONFIG_NET stays so the NE2000
# boot-smoke-test path still works when explicitly requested.  Everything
# below has no role in the TinyX dock/launcher steady state and free
# either kernel image bytes (smaller "reserved" at boot) or slab pressure.

# --- Debug / introspection (kept for development; drop on production) ---
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_SCHEDSTATS is not set
# CONFIG_TIMER_STATS is not set
# CONFIG_LATENCYTOP is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_PRINTK_TIMESTAMP is not set

# --- Hardware not present on BE-300 ---
# CONFIG_VGA_CONSOLE is not set
# CONFIG_FW_LOADER is not set
# CONFIG_HID is not set
# CONFIG_HID_SUPPORT is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_INPUT_JOYSTICK is not set
# CONFIG_INPUT_TABLET is not set
# CONFIG_INPUT_MISC is not set

# --- Subsystems unused by TinyX dock session ---
# CONFIG_SYSVIPC is not set
# CONFIG_POSIX_MQUEUE is not set
# CONFIG_AUDIT is not set
# CONFIG_KEXEC is not set
# CONFIG_PROFILING is not set
# CONFIG_OPROFILE is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_GCOV_KERNEL is not set
# CONFIG_LOCKUP_DETECTOR is not set
# CONFIG_FHANDLE is not set
# CONFIG_USELIB is not set
# CONFIG_NAMESPACES is not set
# CONFIG_CGROUPS is not set
# CONFIG_PARTITION_ADVANCED is not set
# CONFIG_BLK_DEV_BSG is not set
# CONFIG_PROC_PAGE_MONITOR is not set
# CONFIG_FTRACE is not set
# CONFIG_TRACING is not set
# CONFIG_KGDB is not set

# Note: JFFS2_ZLIB is kept because mkfs.jffs2 defaults to zlib for some
# nodes; disabling it would refuse to mount the rootfs.  Could trim further
# by passing --compr-mode=none/size to mkfs.jffs2 in Phase 7b.
