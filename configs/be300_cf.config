# CompactFlash boot overlay for arch/mips/configs/be300_defconfig.
# The kernel mounts the ext2 root filesystem from the CF card's second
# partition after the CF recovery loader has copied vmlinux into SDRAM.

# CONFIG_BLK_DEV_INITRD is not set
CONFIG_INITRAMFS_SOURCE=""
CONFIG_CMDLINE="earlyprintk console=ttyVR0,115200 root=/dev/sda2 rootfstype=ext2 rw rootwait init=/sbin/cf-init"
CONFIG_EXT2_FS=y
CONFIG_MSDOS_PARTITION=y
CONFIG_ATA=y
CONFIG_PATA_PLATFORM=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_INPUT_EVDEV=y
