# BE-300 2.4.18 networking overlay — merge over config_be300 to enable
# the ISA-style NE2000 driver against the BE-300 emulator's --ne2000
# PCMCIA card window (PA 0x0a00c000+).  The 4.2.9 build reaches the
# same card via PCMCIA + pcnet_cs; 2.4 takes the simpler path of
# probing it as an ISA chip at port 0x300 because the emulator keeps
# the I/O window enabled and set_io_port_base(KSEG1ADDR(0x0a00c000))
# from setup.c maps port 0x300 -> 0xaa00c300 which is where the chip
# lives.
#
# Merge contract: build_be300_2_4_kernel.sh's pgui path strips the
# "# ... is not set" lines for each option below, then appends the
# "=y" lines.  2.4 oldconfig honors the later occurrence so this works
# as a set-on override.
#
# Existing pgui kernel config already has:
#   CONFIG_NET, CONFIG_INET, CONFIG_PACKET, CONFIG_UNIX  (patch 0004)
#   loopback (always built)

CONFIG_NETDEVICES=y

# Force-enable CONFIG_ISA so CONFIG_NET_ISA + CONFIG_NE2000 become
# selectable.  The BE-300 has no real ISA bus, but inb/outb against
# the IO_PORT_BASE-mapped window behave the same way; ne.c just does
# port-relative inb/outb to detect and drive the chip.  The PCMCIA
# negotiation that would normally enable the card window is bypassed
# because the emulator keeps the C000/D000 window enabled (patch 0013
# also writes the bridge enable bit).
CONFIG_ISA=y

# Ethernet (10/100) layer + ISA-style probing.
CONFIG_NET_ETHERNET=y
CONFIG_NET_ISA=y

# 8390-family driver shared by NE1000/NE2000 ISA cards and the PCMCIA
# variant (pcnet_cs).  ne.c probes at the requested I/O port and
# initialises the chip without needing the PCMCIA stack.
CONFIG_NE2000=y

# BusyBox udhcpc speaks raw AF_PACKET sockets; CONFIG_PACKET is on
# already.  We don't need CONFIG_FILTER (BPF) for the simple udhcpc
# DHCP_DISCOVER / DHCP_OFFER exchange.
