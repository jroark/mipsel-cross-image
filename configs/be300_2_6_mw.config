# BE-300 2.6.8.1 Microwindows overlay — merged over be300_2_6_defconfig by
# build_be300_2_6_kernel.sh when BE300_2_6_UI=mw.
#
# The 2003 linux4.be nxterm in the mw donor rootfs hardcodes BSD ptys
# (/dev/ptyp%d), which be300_2_6_defconfig leaves out because the OPIE
# profile only uses UNIX98 ptys.  scripts/stage_legacy_mw_rootfs.sh adds
# the /dev/ptyp0..15 and /dev/ttyp0..15 nodes.

CONFIG_LEGACY_PTYS=y
CONFIG_LEGACY_PTY_COUNT=16
