# BE-300 2.4.18 Opie overlay — merge over config_be300 to add the
# userspace-runtime features Opie 1.2.5 / Qt-Embedded 2.3.10 wants and
# that the default 2.4.18 BE-300 config (a kernel-bringup minimum) does
# not include.
#
# Merge contract: build_be300_2_4_kernel.sh strips the `# … is not set`
# lines for each option below, then appends the `=y` lines.  2.4 oldconfig
# honors the later occurrence, so this is equivalent to a "set y" override.
#
# Already-on in config_be300 (leave alone, do not re-enable here):
#   CONFIG_VT, CONFIG_VT_CONSOLE, CONFIG_FB, CONFIG_FB_SIMPLE,
#   CONFIG_FBCON_ADVANCED, CONFIG_FBCON_CFB16, CONFIG_FBCON_FONTS,
#   CONFIG_INPUT, CONFIG_INPUT_EVDEV, CONFIG_INPUT_KEYBDEV,
#   CONFIG_JFFS2_FS, CONFIG_MTD_BLOCK, CONFIG_MTD_CHAR,
#   CONFIG_UNIX98_PTYS, CONFIG_UNIX98_PTY_COUNT=256,
#   CONFIG_CASIO_BE300_NAND, CONFIG_CASIO_BE300_TOUCH,
#   CONFIG_CASIO_BE300_STOWAWAY, CONFIG_CASIO_BE300_IRQ_CASCADE,
#   CONFIG_NET (via patch 0004), CONFIG_SYSVIPC (via patch 0004),
#   CONFIG_SYSCTL (via patch 0004).
#
# Deferred to a later cut:
#   CONFIG_APM — 2.4.18's apm.c is x86-only; the 2.6-era
#   CONFIG_APM_EMULATION doesn't exist yet.  Opie's light-and-power
#   applet falls back to a no-info placeholder when /proc/apm is absent.

# tmpfs for /tmp and /root (Opie writes QPE config + temp files there;
# JFFS2 root is too slow/write-amplified for transient data).
CONFIG_TMPFS=y

# ramfs is the older builtin sibling of tmpfs.  Keep it as a fallback
# mount type for /tmp if a future kernel revision drops SHMEM-dep TMPFS.
CONFIG_RAMFS=y

# embeddedkonsole opens a pty pair from /dev/ptmx; needs devpts mounted
# on /dev/pts to allocate them.
CONFIG_DEVPTS_FS=y
