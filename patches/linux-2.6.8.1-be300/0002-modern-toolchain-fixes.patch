+/*
+ * MIPS board setup hooks run from setup_arch() via do_earlyinitcalls().
+ * arch/mips/kernel/vmlinux.lds.S collects .initcall.early1.init, but the
+ * kernel.org 2.6.8.1 tree never defined the macro the boards use, so
+ * early_initcall(fn) silently became an implicit-int declaration and the
+ * hook (e.g. vr41xx_pmu_init) never ran.
+ */
+#define early_initcall(fn) \
+	static initcall_t __initcall_##fn __attribute_used__ \
+	__attribute__((__section__(".initcall.early1.init"))) = fn
+
 #define __exitcall(fn) \
 	static exitcall_t __exitcall_##fn __exit_call = fn
 
