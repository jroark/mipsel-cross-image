-static unsigned int clear_page_array[0x130 / 4];
-
-void clear_page(void * page) __attribute__((alias("clear_page_array")));
+/*
+ * clear_page/copy_page are generated into these buffers at boot.  Modern
+ * GCC refuses a function alias of an array, so define the storage and the
+ * global function symbol in assembly and reach it from C by asm label.
+ */
+__asm__(
+	"	.data\n"
+	"	.align	3\n"
+	"	.globl	clear_page\n"
+	"	.type	clear_page, @function\n"
+	"clear_page:\n"
+	"	.space	0x130\n"
+	"	.size	clear_page, 0x130\n"
+	"	.globl	copy_page\n"
+	"	.type	copy_page, @function\n"
+	"copy_page:\n"
+	"	.space	0x148\n"
+	"	.size	copy_page, 0x148\n"
+	"	.previous\n");
+
+extern unsigned int clear_page_array[0x130 / 4] __asm__("clear_page");
 
 EXPORT_SYMBOL(clear_page);
 
@@ -51,9 +69,7 @@ EXPORT_SYMBOL(clear_page);
  * R4600 v2.0:				0x07c bytes
  * With prefetching, 16 byte strides	0x0b8 bytes
  */
-static unsigned int copy_page_array[0x148 / 4];
-
-void copy_page(void *to, void *from) __attribute__((alias("copy_page_array")));
+extern unsigned int copy_page_array[0x148 / 4] __asm__("copy_page");
 
 EXPORT_SYMBOL(copy_page);
 
