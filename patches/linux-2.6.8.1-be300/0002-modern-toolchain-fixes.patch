diff --git a/arch/mips/lib/gcc-helpers.c b/arch/mips/lib/gcc-helpers.c
new file mode 100644
index 0000000000000000000000000000000000000000..2a61d7eba144c6134e6505c1daaeec4a440e92ba
--- /dev/null
+++ b/arch/mips/lib/gcc-helpers.c
@@ -0,0 +1,103 @@
+/*
+ * Out-of-line helpers that modern GCC emits calls to on its own.
+ *
+ * The kernel does not link libgcc.  GCC 10 lowers 64-bit shifts on o32 to
+ * __ashldi3/__ashrdi3/__lshrdi3, and turns some sprintf()/strcat() patterns
+ * into strcpy() calls even though <asm/string.h> only offers a static
+ * inline strcpy.  This file must not include <linux/string.h> and is built
+ * with -fno-builtin so the bodies are not turned back into the same calls.
+ * The BE-300 kernel is built without modules, so nothing is exported.
+ *
+ * This file is subject to the terms and conditions of the GNU General Public
+ * License.  See the file "COPYING" in the main directory of this archive
+ * for more details.
+ */
+typedef int si_t;
+typedef unsigned int usi_t;
+
+struct dw_words {
+#ifdef __MIPSEL__
+	si_t low, high;
+#else
+	si_t high, low;
+#endif
+};
+
+typedef union {
+	struct dw_words s;
+	long long ll;
+} dw_t;
+
+long long __ashldi3(long long u, int b)
+{
+	dw_t uu, w;
+	int bm;
+
+	if (b == 0)
+		return u;
+	uu.ll = u;
+	bm = 32 - b;
+	if (bm <= 0) {
+		w.s.low = 0;
+		w.s.high = (usi_t)uu.s.low << -bm;
+	} else {
+		usi_t carries = (usi_t)uu.s.low >> bm;
+
+		w.s.low = (usi_t)uu.s.low << b;
+		w.s.high = ((usi_t)uu.s.high << b) | carries;
+	}
+	return w.ll;
+}
+
+long long __ashrdi3(long long u, int b)
+{
+	dw_t uu, w;
+	int bm;
+
+	if (b == 0)
+		return u;
+	uu.ll = u;
+	bm = 32 - b;
+	if (bm <= 0) {
+		/* w.s.high = 1..1 or 0..0 */
+		w.s.high = uu.s.high >> 31;
+		w.s.low = uu.s.high >> -bm;
+	} else {
+		usi_t carries = (usi_t)uu.s.high << bm;
+
+		w.s.high = uu.s.high >> b;
+		w.s.low = ((usi_t)uu.s.low >> b) | carries;
+	}
+	return w.ll;
+}
+
+long long __lshrdi3(long long u, int b)
+{
+	dw_t uu, w;
+	int bm;
+
+	if (b == 0)
+		return u;
+	uu.ll = u;
+	bm = 32 - b;
+	if (bm <= 0) {
+		w.s.high = 0;
+		w.s.low = (usi_t)uu.s.high >> -bm;
+	} else {
+		usi_t carries = (usi_t)uu.s.high << bm;
+
+		w.s.high = (usi_t)uu.s.high >> b;
+		w.s.low = ((usi_t)uu.s.low >> b) | carries;
+	}
+	return w.ll;
+}
+
+char *strcpy(char *dest, const char *src)
+{
+	char *tmp = dest;
+
+	while ((*dest++ = *src++) != '\0')
+		;
+	return tmp;
+}
+
