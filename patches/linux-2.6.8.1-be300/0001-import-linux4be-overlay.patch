--- a/include/asm-mips/r4kcache.h
+++ b/include/asm-mips/r4kcache.h
@@ -60,7 +60,13 @@ static inline void flush_icache_line(unsigned long addr)
 
 static inline void flush_dcache_line(unsigned long addr)
 {
+#ifdef CONFIG_CASIO_BE300
+	/* VR4131 cache bug: Hit_Writeback_Inv_D must be split. */
+	cache_op(Hit_Writeback_D, addr);
+	cache_op(Hit_Invalidate_D, addr);
+#else
 	cache_op(Hit_Writeback_Inv_D, addr);
+#endif
 }
 
 static inline void invalidate_dcache_line(unsigned long addr)
@@ -107,14 +113,23 @@ static inline void protected_writeback_dcache_line(unsigned long addr)
 	__asm__ __volatile__(
 		".set noreorder\n\t"
 		".set mips3\n"
+#ifdef CONFIG_CASIO_BE300
+		/* VR4131 cache bug: Hit_Writeback_D then Hit_Invalidate_D. */
+		"1:\tcache %0,(%1)\n\tcache %2,(%1)\n"
+#else
 		"1:\tcache %0,(%1)\n"
+#endif
 		"2:\t.set mips0\n\t"
 		".set reorder\n\t"
 		".section\t__ex_table,\"a\"\n\t"
 		STR(PTR)"\t1b,2b\n\t"
 		".previous"
 		:
+#ifdef CONFIG_CASIO_BE300
+		: "i" (Hit_Writeback_D), "r" (addr), "i" (Hit_Invalidate_D));
+#else
 		: "i" (Hit_Writeback_Inv_D), "r" (addr));
+#endif
 }
 
 /*
@@ -171,7 +186,12 @@ static inline void blast_dcache16_page(unsigned long page)
 	unsigned long end = start + PAGE_SIZE;
 
 	do {
+#ifdef CONFIG_CASIO_BE300
+		cache16_unroll32(start,Hit_Writeback_D);
+		cache16_unroll32(start,Hit_Invalidate_D);
+#else
 		cache16_unroll32(start,Hit_Writeback_Inv_D);
+#endif
 		start += 0x200;
 	} while (start < end);
 }
@@ -314,7 +334,12 @@ static inline void blast_dcache32_page(unsigned long page)
