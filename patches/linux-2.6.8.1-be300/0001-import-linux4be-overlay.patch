diff --git a/arch/mips/vr41xx/casio-be300/init.c b/arch/mips/vr41xx/casio-be300/init.c
new file mode 100644
index 0000000000000000000000000000000000000000..d4cbfdedbb997ad08ecb39619421c85bbf84388a
--- /dev/null
+++ b/arch/mips/vr41xx/casio-be300/init.c
@@ -0,0 +1,59 @@
+/*
+ * arch/mips/vr41xx/casio-be300/init.c
+ *
+ * PROM/memory initialization for the Casio Cassiopeia BE-300.
+ *
+ * Copyright (C) 2004 Linux4.BE
+ * based on prom.c (C) 2002 Paul Mundt <lethal@chaoticdreams.org>
+ *
+ * The BE-300 SPL zeroes a0..a3 before jumping to the kernel, so there are
+ * no firmware arguments; arcs_cmdline keeps its CONFIG_CMDLINE default.
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by the Free
+ * Software Foundation; either version 2 of the License, or (at your option)
+ * any later version.
+ */
+#include <linux/config.h>
+#include <linux/init.h>
+#include <linux/mm.h>
+#include <linux/kernel.h>
+#include <linux/string.h>
+
+#include <asm/bootinfo.h>
+
+const char *get_system_type(void)
+{
+	return "NEC VR4131 Casio Cassiopeia BE-300";
+}
+
+void __init prom_init(void)
+{
+	int argc, i;
+	char **argv;
+
+	argc = fw_arg0;
+	argv = (char **)fw_arg1;
+
+	for (i = 1; i < argc; i++) {
+		strcat(arcs_cmdline, argv[i]);
+		if (i < (argc - 1))
+			strcat(arcs_cmdline, " ");
+	}
+
+	mips_machgroup = MACH_GROUP_NEC_VR41XX;
+	mips_machtype = MACH_CASIO_BE300;
+
+	/*
+	 * The vr41xx common code does not register memory.  Do it here
+	 * rather than relying on mem= so the kernel never allocates beyond
+	 * physical SDRAM.  The top page is left out like linux4be did.
+	 */
+	add_memory_region(0, (CONFIG_CASIO_BE300_SDRAM_MB << 20) - PAGE_SIZE,
+			  BOOT_MEM_RAM);
+}
+
+unsigned long __init prom_free_prom_memory(void)
+{
+	return 0;
+}
diff --git a/arch/mips/vr41xx/casio-be300/setup.c b/arch/mips/vr41xx/casio-be300/setup.c
new file mode 100644
index 0000000000000000000000000000000000000000..4edee8bc010837603156cbf675a9cb1aaf4f359f
--- /dev/null
+++ b/arch/mips/vr41xx/casio-be300/setup.c
@@ -0,0 +1,111 @@
+/*
+ * arch/mips/vr41xx/casio-be300/setup.c
+ *
+ * Setup routines for the Casio Cassiopeia BE-300.
+ *
+ * Copyright (C) 2002 Paul Mundt <lethal@chaoticdreams.org>
+ * Linux 2.6.8.1 port of the 4.2.9 board setup, 2026.
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by the Free
+ * Software Foundation; either version 2 of the License, or (at your option)
+ * any later version.
+ */
+#include <linux/config.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/console.h>
+#include <linux/ioport.h>
+#include <linux/string.h>
+
+#include <asm/addrspace.h>
+#include <asm/io.h>
+#include <asm/bootinfo.h>
+
+/*
+ * ISA-style I/O ports: inb(0x300) must hit the VRC4173 PCMCIA I/O window at
+ * PA 0x0A00C300, so the port base is the KSEG1 alias of PA 0x0A00C000.
+ */
+#define BE300_ISA_IO_BASE	0x0a00c000
+#define BE300_ISA_IO_SIZE	0x05ff4000
+
+/* VRC4173 companion SIU (dock UART): 16550-like, 4-byte register stride. */
+#define BE300_UART_BASE		0x0a008680
+#define BE300_UART_OFS_THR	0x00
+#define BE300_UART_OFS_LSR	0x14
+#define BE300_UART_LSR_THRE	0x20
+
+/*
+ * Set while the Stowaway keyboard driver owns the companion SIU.  Weak so
+ * the board links without CONFIG_CASIO_BE300_STOWAWAY.
+ */
+extern int be300_stowaway_owns_uart __attribute__((weak));
+
+void prom_putchar(char c)
+{
+	volatile u8 *uart = (volatile u8 *)KSEG1ADDR(BE300_UART_BASE);
+	int timeout = 10000;
+
+	if (&be300_stowaway_owns_uart && be300_stowaway_owns_uart)
+		return;
+
+	while ((uart[BE300_UART_OFS_LSR] & BE300_UART_LSR_THRE) == 0)
+		if (--timeout == 0)
+			return;	/* bail if no serial cable connected */
+	uart[BE300_UART_OFS_THR] = c;
+}
+
+/*
+ * Boot console: mirrors printk to the companion UART from setup_arch()
+ * onwards so early boot is visible on the emulator's serial1 output.  It is
+ * dropped at late_initcall time (the framebuffer console owns tty0 by then)
+ * unless "keep_bootcon" is on the command line, because the Stowaway dock
+ * shares this UART.
+ */
+static void be300_bootcon_write(struct console *con, const char *s,
+				unsigned int n)
+{
+	while (n--) {
+		if (*s == '\n')
+			prom_putchar('\r');
+		prom_putchar(*s++);
+	}
+}
+
+static struct console be300_bootcon = {
+	.name	= "bootcon",
+	.write	= be300_bootcon_write,
+	.flags	= CON_PRINTBUFFER,
+	.index	= -1,
+};
+
+static int be300_keep_bootcon;
+
+static int __init be300_keep_bootcon_setup(char *str)
+{
+	be300_keep_bootcon = 1;
+	return 1;
+}
+__setup("keep_bootcon", be300_keep_bootcon_setup);
+
+static int __init casio_be300_setup(void)
+{
+	set_io_port_base(KSEG1ADDR(BE300_ISA_IO_BASE));
+	ioport_resource.start = 0;
+	ioport_resource.end = BE300_ISA_IO_SIZE - 1;
+
+	register_console(&be300_bootcon);
+
+	return 0;
+}
+
+early_initcall(casio_be300_setup);
+
+static int __init casio_be300_bootcon_off(void)
+{
+	if (!be300_keep_bootcon)
+		unregister_console(&be300_bootcon);
+	return 0;
+}
+
+late_initcall(casio_be300_bootcon_off);
