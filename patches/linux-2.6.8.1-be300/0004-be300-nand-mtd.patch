 arch/mips/vr41xx/casio-be300/Makefile |   2 +
 arch/mips/vr41xx/casio-be300/nand.c   | 379 ++++++++++++++++++++++++++
 3 files changed, 390 insertions(+)
 create mode 100644 arch/mips/vr41xx/casio-be300/nand.c

