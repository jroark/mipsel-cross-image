From: BE300 Patch Generator <be300@example.invalid>
Date: Thu, 5 Nov 2026 12:00:00 -0800
Subject: [PATCH] linux-4.2.9: settle and verify VR41xx RTC writes

VR4131 UM 13.2.1: ETIME takes a new count only once all three words are
written, and another write must wait at least 100 us. The RTC runs in its
own clock domain; on a real BE-300 a read straight after the write still
returned the old count (glaze-os kernel/drivers/rtc.c). Wait 200 us
before and after the write, read the count back, and retry up to three
times, returning -EIO if it never takes.

--- a/drivers/rtc/rtc-vr41xx.c	2026-11-05 17:25:41
+++ b/drivers/rtc/rtc-vr41xx.c	2026-11-05 17:25:41
@@ -17,6 +17,7 @@
  *  along with this program; if not, write to the Free Software
  *  Foundation, Inc., 59 Temple Place, Suite 330, Boston, MA  02111-1307  USA
  */
+#include <linux/delay.h>
 #include <linux/err.h>
 #include <linux/fs.h>
 #include <linux/init.h>
@@ -115,17 +116,35 @@
 	       ((time64_t)first_low >> 15);
 }
 
-static inline void write_elapsed_second(time64_t sec)
+/*
+ * VR4131 UM 13.2.1: a new count is valid once all three words are written,
+ * and writing again must wait at least 100 us (three 32.768 kHz clocks).
+ * The RTC runs in its own clock domain: on a real BE-300 a read straight
+ * after the write still returned the old count (glaze-os
+ * kernel/drivers/rtc.c). Settle on both sides, read back, retry.
+ */
+#define ETIME_SETTLE_US	200
+
+static inline int write_elapsed_second(time64_t sec)
 {
 	u64 elapsed = sec;
+	time64_t now;
+	int attempt;
 
-	spin_lock_irq(&rtc_lock);
-
-	rtc1_write(ETIMELREG, (uint16_t)(elapsed << 15));
-	rtc1_write(ETIMEMREG, (uint16_t)(elapsed >> 1));
-	rtc1_write(ETIMEHREG, (uint16_t)(elapsed >> 17));
+	for (attempt = 0; attempt < 3; attempt++) {
+		spin_lock_irq(&rtc_lock);
+		udelay(ETIME_SETTLE_US);
+		rtc1_write(ETIMELREG, (uint16_t)(elapsed << 15));
+		rtc1_write(ETIMEMREG, (uint16_t)(elapsed >> 1));
+		rtc1_write(ETIMEHREG, (uint16_t)(elapsed >> 17));
+		udelay(ETIME_SETTLE_US);
+		spin_unlock_irq(&rtc_lock);
 
-	spin_unlock_irq(&rtc_lock);
+		now = read_elapsed_second();
+		if (now >= sec && now - sec < 2)
+			return 0;
+	}
+	return -EIO;
 }
 
 static void vr41xx_rtc_release(struct device *dev)
@@ -167,9 +186,7 @@
 	if (elapsed_sec < 0)
 		return -EINVAL;
 
-	write_elapsed_second(elapsed_sec);
-
-	return 0;
+	return write_elapsed_second(elapsed_sec);
 }
 
 static int vr41xx_rtc_read_alarm(struct device *dev, struct rtc_wkalrm *wkalrm)
