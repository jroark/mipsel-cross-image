Subject: [PATCH 2/4] linux-4.2.9: add Casio BE-300 board support


diff --git a/arch/mips/vr41xx/Kconfig b/arch/mips/vr41xx/Kconfig
index 74927b4..12b40be 100644
--- a/arch/mips/vr41xx/Kconfig
+++ b/arch/mips/vr41xx/Kconfig
@@ -61,6 +61,32 @@ config ZAO_CAPCELLA
 	select SYS_SUPPORTS_32BIT_KERNEL
 	select SYS_SUPPORTS_LITTLE_ENDIAN
 
+config CASIO_BE300
+	bool "CASIO CASSIOPEIA BE-300"
+	select CEVT_R4K
+	select CSRC_R4K
+	select DMA_NONCOHERENT
+	select IRQ_MIPS_CPU
+	select ISA
+	select HAVE_PATA_PLATFORM
+	select SYS_SUPPORTS_32BIT_KERNEL
+	select SYS_SUPPORTS_LITTLE_ENDIAN
+	select SYS_HAS_EARLY_PRINTK
+	select FB_CFB_FILLRECT if FB
+	select FB_CFB_COPYAREA if FB
+	select FB_CFB_IMAGEBLIT if FB
+	select INPUT_POLLDEV
+
 endchoice
+
+config CASIO_BE300_SDRAM_MB
+	int "BE-300 SDRAM size in MiB"
+	depends on CASIO_BE300
+	range 16 64
+	default 16
+	help
+	  SDRAM size registered during early BE-300 boot. Use 16 for
+	  real hardware and stock emulator boots, or 64 when booting the
+	  emulator with --sdram 64.
 
 choice
diff --git a/arch/mips/vr41xx/Platform b/arch/mips/vr41xx/Platform
index b6c8d5c..35902e9 100644
--- a/arch/mips/vr41xx/Platform
+++ b/arch/mips/vr41xx/Platform
@@ -30,3 +30,15 @@ load-$(CONFIG_VICTOR_MPC30X)	+= 0xffffffff80001000
 # ZAO Networks Capcella (VR4131)
 #
 load-$(CONFIG_ZAO_CAPCELLA)	+= 0xffffffff80000000
+
+#
+# CASIO CASSIOPEIA BE-300 (VR4131)
+#
+platform-$(CONFIG_CASIO_BE300)	+= vr41xx/casio-be300/
+# Load above the BE-300 boot ROM's RAM scratch zone. The ROM's MIPS16
+# record walker keeps state in 0x80010000-0x80010300 and reads from the
+# stack at 0x80003800. Loading the kernel at 0x80020000 (PA 0x20000,
+# 128 KiB into SDRAM) leaves both regions untouched while the walker is
+# copying records into RAM, so the walker can finish and write the
+# 0x24FC mailbox correctly.
+load-$(CONFIG_CASIO_BE300)	+= 0xffffffff80020000
