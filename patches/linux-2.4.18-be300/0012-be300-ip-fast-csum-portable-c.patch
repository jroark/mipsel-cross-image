+	/* Portable C version: bypasses a modern-gcc (10.x) miscompile
+	 * of the original inline asm where the receiver's inlined
+	 * ip_fast_csum() computed a different bit pattern than the
+	 * sender's, causing every loopback packet to be dropped with
+	 * ip_rcv InHdrErrors.  See patches/linux-2.4.18-be300/
+	 * 0012-be300-ip-fast-csum-portable-c.patch for the diagnosis. */
+	unsigned int sum = 0;
+	unsigned int i;
+	for (i = 0; i < ihl; i++) {
+		unsigned int w = *(unsigned int *)(iph + i * 4);
+		sum += w;
+		if (sum < w)
+			sum++;	/* end-around carry */
+	}
+	/* Fold 32 -> 16. */
+	sum = (sum & 0xffff) + (sum >> 16);
+	sum = (sum & 0xffff) + (sum >> 16);
+	return (unsigned short)(~sum);
