--- a/include/net/ipv6.h
+++ b/include/net/ipv6.h
@@ -87,6 +87,14 @@
 #ifdef __KERNEL__
 
 #include <net/sock.h>
+/*
+ * Modern GCC requires a complete struct type before declaring an array
+ * of it (even as extern). The legacy 2.4.18 header order assumed older
+ * GCC's lazy size resolution. Pull in <net/snmp.h> here so the three
+ * struct ipv6_mib / icmpv6_mib / udp_mib arrays below have a defined
+ * element type at the point of declaration.
+ */
+#include <net/snmp.h>
 
 extern struct ipv6_mib		ipv6_statistics[NR_CPUS*2];
 #define IP6_INC_STATS(field)		SNMP_INC_STATS(ipv6_statistics, field)
--- a/include/net/icmp.h
+++ b/include/net/icmp.h
@@ -23,6 +23,14 @@
 
 #include <net/sock.h>
 #include <net/protocol.h>
+/*
+ * Modern GCC requires a complete struct type before declaring an array
+ * of it (even as extern). The legacy 2.4.18 header order assumed older
+ * GCC's lazy size resolution. Pull in <net/snmp.h> here so the
+ * `struct icmp_mib icmp_statistics[]` array below has a defined element
+ * type at the point of declaration.
+ */
+#include <net/snmp.h>
 
 struct icmp_err {
   int		errno;
--- a/arch/mips/Makefile
+++ b/arch/mips/Makefile
@@ -82,6 +82,16 @@
 # to __stack_chk_guard / __stack_chk_fail that the 2.4 kernel doesn't
 # provide. Turn the protector off (kernel doesn't want it anyway).
 GCCFLAGS	+= -fno-stack-protector
+
+# 2.4.18 headers use the classic GNU `extern __inline` semantics — an
+# inline definition that is NOT emitted as a standalone object. C99
+# inverted those semantics (extern inline = emit standalone), and modern
+# GCC follows C99 by default, so the 500+ `extern __inline` sites in
+# include/net/{tcp,ip}.h get duplicated across every TU and trip
+# multiple-definition errors at link time (e.g. fib_hash.c + utils.c
+# both ending up with their own copy of `between`). Restore the old
+# semantics globally.
+GCCFLAGS	+= -fgnu89-inline
 ifdef CONFIG_CPU_R4X00
 GCCFLAGS	+= -mcpu=r4600 -mips2 -Wa,--trap
 endif
