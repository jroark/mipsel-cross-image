+ * it under the terms of the GNU General Public License version 2.
+ */
+
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/sched.h>
+#include <linux/ide.h>
+#include <linux/ioport.h>
+#include <linux/hdreg.h>
+#include <asm/ptrace.h>
+#include <asm/io.h>
+#include <asm/addrspace.h>
+#include <asm/vrc4173.h>
+
+#define BE300_CF_BASE_PA	0x0A00C170
+#define BE300_CF_ALT_PA		0x0A00C376
+/* mips_io_port_base is set to KSEG1ADDR(0x0A00C000) in
+ * casio-be300/setup.c, so inb(0x170)/outb(...,0x170) hits PA 0x0A00C170
+ * and inb(0x376) hits PA 0x0A00C376. Pass these as port offsets to the
+ * IDE framework; it'll apply mips_io_port_base via standard inb/outb. */
+#define BE300_CF_BASE		0x170
+#define BE300_CF_ALT		0x376
+
+/* ----- ide_ops hooks ------------------------------------------------- */
+
+/*
+ * The CF socket asserts the VRC4173 GIRQ0 bit-0 cascade source, which
+ * irq_be300.c demuxes onto VRC4173_IRQ_BASE + 0. Earlier revisions of
+ * this driver returned a placeholder IRQ + stubbed request_irq, which
+ * let the channel register but failed all reads with `lost interrupt`
+ * + `DriveStatusError` because the IDE state machine never saw an
+ * IRQ. With the cascade now wired we return the real sub-IRQ and call
+ * the kernel's request_irq for real.
+ */
+static int be300_ide_default_irq(ide_ioreg_t base)
+{
+	return VRC4173_IRQ_BASE + 0;
+}
+
+static ide_ioreg_t be300_ide_default_io_base(int index)
+{
+	if (index == 0)
+		return BE300_CF_BASE;
+	return 0;
+}
+
+static void be300_ide_init_hwif_ports(hw_regs_t *hw, ide_ioreg_t data_port,
+				      ide_ioreg_t ctrl_port, int *irq)
+{
+	ide_ioreg_t reg = data_port;
+	int i;
+
+	for (i = IDE_DATA_OFFSET; i <= IDE_STATUS_OFFSET; i++) {
+		hw->io_ports[i] = reg;
+		reg += 1;
+	}
+	if (ctrl_port)
+		hw->io_ports[IDE_CONTROL_OFFSET] = ctrl_port;
+	else
+		hw->io_ports[IDE_CONTROL_OFFSET] = BE300_CF_ALT;
+	if (irq)
+		*irq = 0;
+	hw->io_ports[IDE_IRQ_OFFSET] = 0;
+}
+
+static int be300_ide_request_irq(unsigned int irq,
+				 void (*handler)(int, void *, struct pt_regs *),
+				 unsigned long flags, const char *device,
+				 void *dev_id)
+{
+	return request_irq(irq, handler, flags, device, dev_id);
+}
+
+static void be300_ide_free_irq(unsigned int irq, void *dev_id)
+{
+	free_irq(irq, dev_id);
+}
+
+/*
+ * The CF taskfile is at a KSEG1 MMIO address (0xAA00C170), not an I/O
+ * port in the standard ioport_resource map, so check_region()/
+ * request_region() would always report "in use" against an empty map.
+ * Stub them so the IDE core's auto-probe sees the region as available
+ * and proceeds to identify the drive. No conflict is possible at this
+ * address because nothing else on the BE-300 maps here.
+ */
+static int be300_ide_check_region(ide_ioreg_t from, unsigned int extent)
+{
+	return 0;
+}
+
+static void be300_ide_request_region(ide_ioreg_t from, unsigned int extent,
+				     const char *name)
+{
+}
+
+static void be300_ide_release_region(ide_ioreg_t from, unsigned int extent)
+{
+}
+
+struct ide_ops be300_ide_ops = {
+	&be300_ide_default_irq,
+	&be300_ide_default_io_base,
+	&be300_ide_init_hwif_ports,
+	&be300_ide_request_irq,
+	&be300_ide_free_irq,
+	&be300_ide_check_region,
+	&be300_ide_request_region,
+	&be300_ide_release_region
+};
+
+/*
+ * No explicit ide_register_hw() here -- the IDE core's
+ * ide_init_default_hwifs() (drivers/ide/ide.c) auto-probes index 0
+ * via our be300_ide_default_io_base() hook and registers the channel
+ * for us. Adding our own registration just creates a conflict.
+ * Compiling this file is enough -- be300_ide_ops is referenced from
+ * setup.c at machine init, and the IDE core finds the CF window.
+ */
+static int __init be300_cf_banner(void)
+{
+	printk(KERN_INFO "BE-300 CF: VRC4173 PCMCIA window @ PA 0x%08X "
+	       "(taskfile), 0x%08X (altstatus); IDE core will auto-probe\n",
+	       BE300_CF_BASE_PA, BE300_CF_ALT_PA);
+	return 0;
+}
+module_init(be300_cf_banner);
+
+MODULE_LICENSE("GPL");
+MODULE_AUTHOR("John Roark");
+MODULE_DESCRIPTION("Casio BE-300 CompactFlash IDE host (VRC4173 PCMCIA window)");
--- /dev/null	2026-05-13 23:48:26
+++ b/arch/mips/vr41xx/vr4131/casio-be300/irq_be300.c	2026-05-13 23:46:47
@@ -0,0 +1,208 @@
+/*
+ * arch/mips/vr41xx/vr4131/casio-be300/irq_be300.c
+ *
+ * Second-level interrupt demuxer for the BE-300, ported from the 4.2.9
+ * board/casio-be300/irq.c driver to the 2.4 cascade API.
+ *
+ * The VR4131 ICU (arch/mips/vr41xx/common/icu.c) reports the GIU summary
+ * as SYSINT1 bit 8, which Linux exposes as GIU_IRQ(0..31) (= 40..71). On
+ * the BE-300 every VRC4173 sub-source (touch, buttons, CF/NE2000, PC
+ * Connect) rides on a single GPIO pin (GIU line 0). The actual cascade
+ * source is the VRC4173 GIRQ0 status register at PA 0x0A000004.
+ *
+ *   SYSINT1.bit8 (GIU)
+ *      +-- GIU0 = GIU_IRQ(0) = 40
+ *            +-- VRC4173 GIRQ0 word @ 0x0A000004:
+ *                  bit 0 -> CF / NE2000   (VRC4173_IRQ_BASE + 0 = 72)
+ *                  bit 1 -> buttons       (VRC4173_IRQ_BASE + 1 = 73)
+ *                  bit 4 -> CommMode      (VRC4173_IRQ_BASE + 4 = 76, unused)
+ *                  bit 9 -> touch (PIU)   (VRC4173_IRQ_BASE + 9 = 81)
+ *
+ * 2.4 cascade flow (arch/mips/vr41xx/common/giu.c):
+ *   - vr41xx_cascade_irq(GIU_IRQ(0), be300_girq0_get_irq) registers a
+ *     per-pin callback that returns the cascaded sub-IRQ number to
+ *     dispatch. giuint_do_IRQ() reads GIRQ0 status via this callback
+ *     and calls do_IRQ(sub_irq, regs).
+ *   - One sub-IRQ per GIU event; multiple pending bits result in
+ *     successive GIU re-assertions (the GIU pin stays high until all
+ *     sub-IRQs are acked).
+ *
+ * GIRQ0 status / ack are write-1-to-clear in the emulator. Bit 0
+ * (CF/NE2000) has a quirk: state_change_pending is cleared only by
+ * reading the CF cause register at PA 0x0A00A03C, not by W1C on the
+ * GIRQ0 ack at 0x0A000014. Match the 4.2.9 driver's order: read cause
+ * first when bit 0 is set, then W1C the GIRQ0 status latch.
+ *
+ * Also force GIUINTENL bit 0 = 1 manually after vr41xx_cascade_irq.
+ * The 4.2.9 driver hits the same edge case where irq_set_chained_handler
+ * doesn't propagate to GIUINTENL on this board; same bare-metal fix here.
+ *
+ * Copyright (C) 2026 John Roark
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2.
+ */
+
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/irq.h>
+#include <linux/interrupt.h>
+#include <linux/types.h>
+#include <asm/io.h>
+#include <asm/addrspace.h>
+#include <asm/vr41xx.h>
+#include <asm/vrc4173.h>
+
+#define BE300_GIRQ0_STATUS	KSEG1ADDR(0x0A000004)
+#define BE300_GIRQ0_ACK		KSEG1ADDR(0x0A000014)
+#define BE300_GIRQ0_CAUSE	KSEG1ADDR(0x0A00A03C)
+#define BE300_GIUINTENL		KSEG1ADDR(0x0F00014C)
+
+#define BE300_GIRQ0_NR		16
+
+/* Software shadow mask. Bits 0..15 map to VRC4173_IRQ_BASE + 0..15. */
+static u32 be300_girq0_mask;
+
+extern int vr41xx_cascade_irq(unsigned int irq, int (*get_irq_number)(int));
+
+static inline u32 girq0_read_status(void)
+{
+	return *(volatile u32 *)BE300_GIRQ0_STATUS;
+}
+
+static inline void girq0_write_ack(u32 bits)
+{
+	*(volatile u32 *)BE300_GIRQ0_ACK = bits;
+}
+
+static inline u32 girq0_read_cause(void)
+{
+	return *(volatile u32 *)BE300_GIRQ0_CAUSE;
+}
+
+static unsigned int be300_girq0_startup(unsigned int irq)
+{
+	be300_girq0_mask |= 1u << (irq - VRC4173_IRQ_BASE);
+	return 0;
+}
+
+static void be300_girq0_shutdown(unsigned int irq)
+{
+	be300_girq0_mask &= ~(1u << (irq - VRC4173_IRQ_BASE));
+}
+
+static void be300_girq0_enable(unsigned int irq)
+{
+	be300_girq0_mask |= 1u << (irq - VRC4173_IRQ_BASE);
+}
+
+static void be300_girq0_disable(unsigned int irq)
+{
+	be300_girq0_mask &= ~(1u << (irq - VRC4173_IRQ_BASE));
+}
+
+static void be300_girq0_ack(unsigned int irq)
+{
+	girq0_write_ack(1u << (irq - VRC4173_IRQ_BASE));
+}
+
+static void be300_girq0_end(unsigned int irq)
+{
+	if (!(irq_desc[irq].status & (IRQ_DISABLED | IRQ_INPROGRESS)))
+		be300_girq0_enable(irq);
+}
+
+static struct hw_interrupt_type be300_girq0_type = {
+	"BE300-GIRQ0",
+	be300_girq0_startup,
+	be300_girq0_shutdown,
+	be300_girq0_enable,
+	be300_girq0_disable,
+	be300_girq0_ack,
+	be300_girq0_end,
+	NULL
+};
+
+/*
+ * Cascade callback invoked by giuint_do_IRQ when GIU pin 0 fires.
+ * Reads GIRQ0 status, applies our software mask, returns the lowest
+ * pending sub-IRQ number; W1Cs the bit we picked (and for bit 0 also
+ * reads the CF cause register, which is the only way to clear the CF
+ * source's internal pending latch).
+ */
+static int be300_girq0_get_irq(int giu_irq)
+{
+	u32 pending = girq0_read_status();
+
+	/* Read cause to clear CF state_change_pending if bit 0 is set —
+	 * the 4.2.9 driver does this before W1Cing GIRQ0. */
+	if (pending & 0x1)
+		(void)girq0_read_cause();
+
+	pending &= be300_girq0_mask;
+	if (!pending)
+		return -EINVAL;
+
+	{
+		int bit;
+
+		/* Find lowest set bit. 2.4's ffs() pulls in generic_ffs which
+		 * isn't linked here; a 16-iteration loop is fine for an IRQ
+		 * dispatch path that runs at most a few times per second. */
+		for (bit = 0; bit < BE300_GIRQ0_NR; bit++)
+			if (pending & (1u << bit))
+				break;
+
+		/* W1C just the chosen bit; the GIU pin will reassert if any
+		 * remaining unmasked bit stays set, and we'll be called again. */
+		girq0_write_ack(1u << bit);
+		return VRC4173_IRQ_BASE + bit;
+	}
+}
+
+/*
+ * Called directly from arch/mips/vr41xx/vr4131/casio-be300/setup.c
+ * (nec_vr41xx_setup) rather than via module_init. The IDE core's
+ * driver_init() initcall calls request_irq() on VRC4173_IRQ_BASE + 0
+ * during its early probe, and request_irq fails silently to deliver
+ * if our IRQ chip isn't already installed. Module_init ordering put
+ * us after the IDE probe; calling from setup.c puts us before any
+ * initcall.
+ */
+int __init be300_irq_cascade_init(void)
+{
+	int i;
+	int err;
+	volatile u16 *inten;
+
+	for (i = 0; i < BE300_GIRQ0_NR; i++) {
+		irq_desc[VRC4173_IRQ_BASE + i].handler = &be300_girq0_type;
+		irq_desc[VRC4173_IRQ_BASE + i].status = IRQ_DISABLED;
+	}
+
+	err = vr41xx_cascade_irq(GIU_IRQ(0), be300_girq0_get_irq);
+	if (err) {
+		printk(KERN_ERR "BE-300 IRQ: vr41xx_cascade_irq(GIU_IRQ(0)) = %d\n",
+		       err);
+		return err;
+	}
+
+	/*
+	 * vr41xx_cascade_irq -> setup_irq -> startup_giuint_irq should set
+	 * GIUINTENL bit 0, but the early-init ordering on this board leaves
+	 * the bit at 0 so giuint_do_IRQ never sees GIU pin 0 fire. Force it
+	 * on manually. Matches the 4.2.9 driver's bare-metal poke.
+	 */
+	inten = (volatile u16 *)BE300_GIUINTENL;
+	*inten = *inten | 0x1;
+
+	printk(KERN_INFO "BE-300 IRQ: VRC4173 GIRQ0 demux at "
+	       "PA 0x0A000004 -> VRC4173_IRQ_BASE..%d (cascade on GIU_IRQ(0))\n",
+	       VRC4173_IRQ_BASE + BE300_GIRQ0_NR - 1);
+	return 0;
+}
+
+MODULE_LICENSE("GPL");
+MODULE_AUTHOR("John Roark");
+MODULE_DESCRIPTION("Casio BE-300 VRC4173 GIRQ0 second-level IRQ demuxer");
