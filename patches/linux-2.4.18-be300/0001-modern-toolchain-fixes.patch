+/*
+ * be300_modern_compat.h — BE-300 modern-toolchain shims for 2.4.18.
+ *
+ * Pulled in via gcc -include from arch/mips/Makefile so every TU sees
+ * the same overrides. Modern GCC (12+) treats __FUNCTION__ as a const
+ * char[] runtime variable, breaking the 1300+ kernel sites that
+ * concatenate it directly into format strings (KERN_ERR __FUNCTION__
+ * "fmt"). Replace with a placeholder string literal so concatenations
+ * resolve at preprocess time; printk("%s", __FUNCTION__) just prints
+ * "<fn>" instead of the real name — acceptable price for a green build.
+ */
+#ifndef _BE300_MODERN_COMPAT_H
+#define _BE300_MODERN_COMPAT_H
+
+#undef __FUNCTION__
+#define __FUNCTION__ "<fn>"
+
+#undef __PRETTY_FUNCTION__
+#define __PRETTY_FUNCTION__ "<fn>"
+
+#endif /* _BE300_MODERN_COMPAT_H */
