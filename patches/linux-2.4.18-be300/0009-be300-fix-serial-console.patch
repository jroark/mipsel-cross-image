 static 	int baud_table[] = {
 		110, 10473,
@@ -79,12 +85,42 @@ static inline void serial_puts(const unsigned char *buf, int count)
 	}
 }
 
+static unsigned long be300_rx_poll_delay(void)
+{
+	unsigned long delay = HZ / BE300_RX_POLL_HZ;
+
+	return delay ? delay : 1;
+}
+
+static void be300_rx_poll(unsigned long data)
+{
+	struct tty_struct *tty = be300_open_tty;
+	int budget = 256;
+	int pushed = 0;
+
+	while (tty && budget-- > 0 &&
+	       (serial_inb(UART_LSR) & UART_LSR_DR)) {
+		unsigned char ch = serial_inb(UART_RX);
+
+		if (tty->flip.count >= TTY_FLIPBUF_SIZE)
+			break;
+		tty_insert_flip_char(tty, ch, TTY_NORMAL);
+		pushed = 1;
+	}
+
+	if (pushed)
+		tty_flip_buffer_push(tty);
+
+	be300_rx_timer.expires = jiffies + be300_rx_poll_delay();
+	add_timer(&be300_rx_timer);
+}
