@@ -137,8 +181,22 @@ static void be300_serial_put_char(struct tty_struct *tty, unsigned char ch)
 static int be300_serial_write(struct tty_struct *tty, int from_user,
 	const unsigned char *buf, int count)
 {
-	serial_puts(buf, count);	
-	return count;
+	int i;
+
+	for (i = 0; i < count; i++) {
+		unsigned char ch;
+
+		if (from_user) {
+			if (get_user(ch, buf + i))
+				return i ? i : -EFAULT;
+		} else {
+			ch = buf[i];
+		}
+		if (ch == '\n')
+			serial_putc('\r');
+		serial_putc(ch);
+	}
+	return i;
 }
 
