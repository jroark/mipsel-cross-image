@@ -107,7 +141,7 @@ int be300_calc_divider(int baud)
 	return 0;
 }
 
-void be300_set_baud(int baud)
+static void be300_set_baud(int baud)
 {
 	int divisor = be300_calc_divider(baud);
 	
@@ -117,11 +151,21 @@ void be300_set_baud(int baud)
 	serial_outb(UART_LCR, UART_LCR_DLAB);	
 	serial_outb(UART_DLL, divisor & 0xFF);
 	serial_outb(UART_DLM, (divisor & 0xff00) >> 8);
-	serial_outb(UART_LCR, UART_LCR_DLAB);
-	
-	/*serial_inb(UART_IER);*/
+	serial_outb(UART_LCR, UART_LCR_WLEN8);
 }
 
+static void be300_configure_uart(int baud)
+{
+	if (!baud)
+		baud = 115200;
+
+	be300_set_baud(baud);
+	serial_outb(UART_LCR, UART_LCR_WLEN8);
+	serial_outb(UART_IER, 0);
+	serial_outb(UART_MCR, UART_MCR_DTR | UART_MCR_RTS);
+	serial_inb(UART_LSR);
+}
